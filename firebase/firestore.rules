rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Check Function
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Cases & Analyses Collections
    match /cases/{caseId} {
      allow read, write: if isAuthenticated() && resource.data.lawyerId == request.auth.uid;
    }
    
    match /caseAnalyses/{analysisId} {
      allow read: if isAuthenticated();
    }
  }
}
